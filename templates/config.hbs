<div class="ov-config-corpo">
  <header class="ov-config-topo">
    <div class="ov-config-selo"><i class="fa-solid fa-cloud-moon" aria-hidden="true"></i></div>
    <div><h2>{{L.Titulo}}</h2><p>{{L.Intro}}</p></div>
  </header>

  <section>
    <h3>{{L.Estilos}}</h3>
    <div class="ov-estilos">
      {{#each estilos}}
      <button type="button" class="ov-estilo {{#if ativo}}ov-on{{/if}}" data-action="estilo" data-estilo="{{id}}">
        <span class="ov-estilo-amostra" style="--cor:{{cor}};--brilho:{{brilho}}"></span><span>{{nome}}</span>
      </button>
      {{/each}}
    </div>
  </section>

  <section>
    <h3>{{L.Cores}}</h3>
    <div class="ov-faixa ov-faixa-cor"><div class="ov-txt"><b>{{cor.nome}}</b><span>{{cor.desc}}</span></div>
      <input type="color" data-campo="cor" value="{{cor.valor}}" aria-label="{{cor.nome}}"></div>
    <div class="ov-faixa ov-faixa-cor"><div class="ov-txt"><b>{{corBrilho.nome}}</b><span>{{corBrilho.desc}}</span></div>
      <input type="color" data-campo="corBrilho" value="{{corBrilho.valor}}" aria-label="{{corBrilho.nome}}"></div>
    {{#each faixas}}
    <div class="ov-faixa ov-faixa-range"><div class="ov-txt"><b>{{nome}}</b><span>{{desc}}</span></div>
      <input type="range" data-campo="{{chave}}" data-unidade="{{unidade}}" min="{{min}}" max="{{max}}" step="1" value="{{valor}}" aria-label="{{nome}}">
      <output data-saida="{{chave}}">{{valor}}{{unidade}}</output></div>
    {{/each}}
  </section>

  <section>
    <div class="ov-faixa ov-faixa-viva"><div class="ov-txt"><b>{{L.Viva}}</b><span>{{L.VivaDica}}</span></div>
      <button type="button" role="switch" aria-checked="{{animada}}" aria-label="{{L.Viva}}" class="ov-chave {{#if animada}}ov-on{{/if}}" data-chave="animada"><span></span></button></div>
    {{#if animada}}{{#each nuvens}}
    <div class="ov-faixa ov-faixa-range"><div class="ov-txt"><b>{{nome}}</b><span>{{desc}}</span></div>
      <input type="range" data-campo="{{chave}}" data-unidade="{{unidade}}" min="{{min}}" max="{{max}}" step="1" value="{{valor}}" aria-label="{{nome}}">
      <output data-saida="{{chave}}">{{valor}}{{unidade}}</output></div>
    {{/each}}{{/if}}
    <p class="ov-dica">{{L.Dica}}</p>
  </section>

  <section>
    <div class="ov-faixa"><div class="ov-txt"><b>{{L.Qualidade}}</b><span>{{L.QualidadeDica}}</span></div>
      <select name="qualidade" class="ov-select">{{#each qualidade.opcoes}}<option value="{{v}}" {{#if (eq v ../qualidade.valor)}}selected{{/if}}>{{nome}}</option>{{/each}}</select></div>
  </section>

  <footer class="ov-config-rodape">
    <button type="button" class="ov-btn" data-action="padrao"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> {{L.Padrao}}</button>
    <span class="ov-espaco"></span>
    <button type="button" class="ov-btn" data-action="cancelar">{{L.Cancelar}}</button>
    <button type="submit" class="ov-btn ov-primario"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> {{L.Salvar}}</button>
  </footer>
</div>
